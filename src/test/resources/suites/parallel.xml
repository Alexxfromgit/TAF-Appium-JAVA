<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  Runs the app tests on two devices at the same time: one thread per <test>.
  Each device needs its own Appium port and UiAutomator2 system port.
  Start both emulators first, e.g.  emulator -avd Pixel_API_33 -port 5554  and  emulator -avd Pixel_API_31 -port 5556
-->
<suite name="Parallel Devices" parallel="tests" thread-count="2">
    <test name="Emulator 5554 - Android 13">
        <parameter name="deviceName" value="emulator-5554"/>
        <parameter name="udid" value="emulator-5554"/>
        <parameter name="platformVersion" value="13"/>
        <parameter name="appiumPort" value="4723"/>
        <parameter name="systemPort" value="8200"/>
        <classes>
            <class name="com.apj.tests.app.MentoringAppTests"/>
            <class name="com.apj.tests.app.GameFTests"/>
        </classes>
    </test>
    <test name="Emulator 5556 - Android 12">
        <parameter name="deviceName" value="emulator-5556"/>
        <parameter name="udid" value="emulator-5556"/>
        <parameter name="platformVersion" value="12"/>
        <parameter name="appiumPort" value="4724"/>
        <parameter name="systemPort" value="8201"/>
        <classes>
            <class name="com.apj.tests.app.MentoringAppTests"/>
            <class name="com.apj.tests.app.GameFTests"/>
        </classes>
    </test>
</suite>
